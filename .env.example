# Container identity. Both values must be nonzero numeric IDs. On Linux, use
# `id -u` and `id -g`, then make the three host paths below owned by these IDs.
PUID=10001
PGID=10001
FILE_UMASK=0027

# Host storage. Pre-create these directories; Compose intentionally refuses to
# create them as root. Keep CONFIG_PATH on a local filesystem (not NFS/SMB).
CONFIG_PATH=./data/config
STAGING_PATH=./data/staging
MUSIC_PATH=./data/music

# Optional server-side download inbox. Point your downloader here, then Fox Den
# can import completed ZIP/audio files without a browser upload.
DOWNLOAD_INBOX_PATH=./data/download-inbox
DOWNLOAD_INBOX_DIR=/downloads
DOWNLOAD_INBOX_SETTLE_SECONDS=30
DOWNLOAD_INBOX_RECURSIVE=true
DOWNLOAD_INBOX_MAX_FILES=200
DOWNLOAD_INBOX_MOVE_FILES=true
DOWNLOAD_INBOX_MIN_BYTES=1048576
DOWNLOAD_INBOX_AUTO_IMPORT=true

# Optional human-controlled server browser. This is for phone use: open the
# browser UI, complete any human prompts yourself, and save downloads to
# /downloads so Fox Den can import them from the server inbox.
# Compose supplies /server-browser/ through the same port as Fox Den.
# No separate browser IP is needed. This value is for standalone app runs only.
REMOTE_BROWSER_URL=/server-browser/
REMOTE_BROWSER_BIND_IP=127.0.0.1
REMOTE_BROWSER_PORT=5800
REMOTE_BROWSER_KIOSK=0
BROWSER_CONFIG_PATH=./data/browser-config
TZ=America/New_York

# The main gateway port. Keep 127.0.0.1 behind a reverse proxy, or
# change this to a specific LAN address / 0.0.0.0 for direct LAN access.
WEB_BIND_IP=127.0.0.1
WEB_PORT=8000

APP_ENVIRONMENT=production
LOG_LEVEL=INFO
WEB_MEMORY_LIMIT=768m
WORKER_MEMORY_LIMIT=1g

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Compose mounts this into the web container as a file; it is not granted to
# the worker. Never commit the populated .env file.
CSRF_SECRET=

# MusicBrainz needs no account or API key. Automatic matching does require a
# real contact email or HTTPS URL in its User-Agent (for example, your admin
# email or site URL). Leave blank only if you accept using incoming tags.
MUSICBRAINZ_CONTACT=
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
COVER_ART_BASE_URL=https://coverartarchive.org

# Jellyfin is optional. If enabled, create an API key in your own Jellyfin
# administrator dashboard and set its base URL here. The key is mounted only
# into the worker as a secret file. Leave both blank to disable refreshes.
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_TIMEOUT_SECONDS=15

# Worker and external-tool limits.
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
LIBRARY_SCAN_INTERVAL_SECONDS=21600
STORAGE_SNAPSHOT_INTERVAL_SECONDS=900
INVENTORY_COMMIT_BATCH_SIZE=50
FFPROBE_TIMEOUT_SECONDS=90
FFMPEG_TIMEOUT_SECONDS=180
METADATA_HTTP_TIMEOUT_SECONDS=20
METADATA_CACHE_DAYS=30

# Archive/upload safety limits (bytes unless otherwise noted).
MAX_UPLOAD_BYTES=4294967296
UPLOAD_CHUNK_BYTES=1048576
ARCHIVE_MAX_FILES=2000
ARCHIVE_MAX_TOTAL_BYTES=8589934592
ARCHIVE_MAX_ENTRY_BYTES=2147483648
ARCHIVE_MAX_COMPRESSION_RATIO=250

# Metadata matching and artwork safety limits.
AUTOMATIC_MATCH_THRESHOLD=94
AUTOMATIC_MATCH_MARGIN=8
MAX_RELEASE_CANDIDATES=5
MAX_ARTWORK_BYTES=26214400
MAX_ARTWORK_PIXELS=40000000

# Stage 2 acquisition queue needs no Spotify API credentials or provider
# account. This is a static public link only; Fox Den Music never submits the
# Spotify URL to the provider server-side.
SPOTIDOWNLOADER_URL=https://spotidownloader.com/
SPOTIFY_BATCH_MAX_URLS=100
SPOTIFY_BATCH_MAX_CHARACTERS=20000
